# usb_reenable: delayed re-toggle of the USB gadget's "enable" node so
# dwc3_gadget_pullup() gets a second chance after VBUS is actually up.
# See recovery/root/init.recovery.usb.rc for why this exists.

type usb_reenable, domain;

# Grant init permission to transition into the usb_reenable domain.
# Without this, init fails to exec the script (avc: denied { transition } ... tclass=process).
allow init usb_reenable:process transition;
dontaudit init usb_reenable:process noatsecure;
allow init usb_reenable:process { siginh rlimitinh };

# Let the domain actually run the script's shell (#!/sbin/sh) and the
# toybox applets it calls (sleep, echo redirects via /sbin/sh built-ins,
# getprop).
allow usb_reenable rootfs:file rx_file_perms;
allow usb_reenable toolbox_exec:file rx_file_perms;

# The only sysfs write this domain actually needs: android_usb's enable
# and functions nodes.
allow usb_reenable sysfs_android_usb:file w_file_perms;

# Reading back sys.usb.config for the echo ${sys.usb.config} substitution.
get_prop(usb_reenable, system_radio_prop)