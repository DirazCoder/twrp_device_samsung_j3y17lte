on fs
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/idProduct D001
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/iManufacturer ${ro.product.manufacturer}
    write /sys/class/android_usb/android0/iProduct ${ro.product.model}
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    # This block used to configure the gadget and stop here, leaving
    # it disabled at boot until some later sys.usb.config property
    # trigger flipped enable on. persist.sys.usb.config=adb (set in
    # default.prop) does fire on property:sys.usb.config=adb below, but
    # that block also races init.rc's own service.adb.root=1 handler
    # for the same android0/enable node (see note on that block below).
    # Enable directly here too so the device enumerates over USB from
    # boot without depending on that race resolving in our favor.
    write /sys/class/android_usb/android0/enable 1

on property:sys.usb.config=none
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/bDeviceClass 0

on property:sys.usb.config=mass_storage,adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/enable 1

# CORRECTED: a previous version of this block wrote "mtp_usb,adb" here
# based on a comment claiming the kernel registers MTP under the name
# "mtp_usb". Checked directly against this device's kernel source
# (drivers/usb/gadget/android.c, f_mtp.c): the function is registered
# as "mtp" (DRIVER_NAME "mtp", .name = "mtp"). "mtp_usb" only appears
# as the /dev/mtp_usb character-device path the MTP function exposes
# to userspace once active -- a different name in a different
# namespace, not what android_usb's functions sysfs write matches
# against. Writing "mtp_usb" as a function name here would fail to
# match any registered function, same silent-failure this comment
# thought it was avoiding. Forwarding ${sys.usb.config} verbatim is
# fine as long as it's actually "mtp,adb" (matches "mtp" + "adb"), so
# this block is written explicitly rather than left to forward the
# property, purely so the working values are visible here.
on property:sys.usb.config=mtp,adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mtp,adb
    write /sys/class/android_usb/android0/enable 1
    start adbd

# FIXED: this block used to write enable via ${service.adb.root} instead
# of a hardcoded 1. service.adb.root controls whether adbd runs as root,
# not whether the USB gadget is enabled -- at boot it's frequently unset
# or 0, which meant this write could disable the gadget right after the
# line above enabled it, leaving the device silently un-enumerable over
# USB despite functions being set correctly. Matches the same fix already
# applied to the "on fs" block above for the identical enable-node race.
on property:sys.usb.config=adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/enable 1
    start adbd
